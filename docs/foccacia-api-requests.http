@api = http://localhost:1904/api
@accept-content = application/json

@season = 2025
@compPPL = PPL
@compCL = CL

@token = Bearer PASTE_TOKEN_USER1
@otherToken = Bearer PASTE_TOKEN_USER2
@invalidToken = Bearer invalid-token
@groupId = PASTE_GROUP_ID

@playerId = 67299

### GET - All competitions (200)
GET {{api}}/competitions

### GET - Teams for Primeira Liga season {{season}} (200)
GET {{api}}/competitions/{{compPPL}}/seasons/{{season}}/teams

### GET - Teams for Champions League season {{season}} (200)
GET {{api}}/competitions/{{compCL}}/seasons/{{season}}/teams

### POST - Create user 1 (201) -> copy token to @token
POST {{api}}/users
Content-Type: {{accept-content}}

{
  "username": "grupo1"
}

### NEGATIVE - 400 (missing username)
POST {{api}}/users
Content-Type: {{accept-content}}

{
}

### POST - Create user 2 (201) -> copy token to @otherToken
POST {{api}}/users
Content-Type: {{accept-content}}

{
  "username": "grupo2"
}

### NEGATIVE - 422 (duplicate username)
POST {{api}}/users
Content-Type: {{accept-content}}

{
  "username": "grupo1"
}

### POST - Create group (201) -> copy id to @groupId
POST {{api}}/groups
Authorization: {{token}}
Content-Type: {{accept-content}}

{
  "name": "Melhores da Primeira Liga",
  "description": "Onze ideal da Primeira Liga {{season}}",
  "competition": "{{compPPL}}",
  "year": {{season}}
}

### GET - User groups (200)
GET {{api}}/groups
Authorization: {{token}}

### NEGATIVE - 401 (no token)
GET {{api}}/groups

### NEGATIVE - 401 (invalid token)
GET {{api}}/groups
Authorization: {{invalidToken}}

### NEGATIVE - 401 (create group without token)
POST {{api}}/groups
Content-Type: {{accept-content}}

{
  "name": "Should fail (no token)",
  "description": "No auth",
  "competition": "{{compPPL}}",
  "year": {{season}}
}

### GET - Group {{groupId}} (200)
GET {{api}}/groups/{{groupId}}
Authorization: {{token}}

### NEGATIVE - 403 (other user reads group)
GET {{api}}/groups/{{groupId}}
Authorization: {{otherToken}}

### NEGATIVE - 404 (group not found)
GET {{api}}/groups/99999
Authorization: {{token}}

### PUT - Update group name/description (200)
PUT {{api}}/groups/{{groupId}}
Authorization: {{token}}
Content-Type: {{accept-content}}

{
  "name": "Melhores da Champions (Atualizado)",
  "description": "Onze ideal da Champions {{season}} (atualizado)"
}

### NEGATIVE - 400 (invalid PUT body)
PUT {{api}}/groups/{{groupId}}
Authorization: {{token}}
Content-Type: {{accept-content}}

{
  "name": ""
}

### POST - Add player 1 (200)
POST {{api}}/groups/{{groupId}}/players
Authorization: {{token}}
Content-Type: {{accept-content}}

{
  "playerId": {{playerId}},
  "playerName": "Vangelis Pavlidis",
  "teamCode": "BEN",
  "teamName": "SL Benfica"
}

### NEGATIVE - 422 (player already in group)
POST {{api}}/groups/{{groupId}}/players
Authorization: {{token}}
Content-Type: {{accept-content}}

{
  "playerId": {{playerId}},
  "playerName": "Vangelis Pavlidis",
  "teamCode": "BEN",
  "teamName": "SL Benfica"
}

### NEGATIVE - 400 (missing required fields)
POST {{api}}/groups/{{groupId}}/players
Authorization: {{token}}
Content-Type: {{accept-content}}

{
  "playerName": "Missing required fields"
}

### NEGATIVE - 422 (player not in group competition/year)
POST {{api}}/groups/{{groupId}}/players
Authorization: {{token}}
Content-Type: {{accept-content}}

{
  "playerId": 999999,
  "playerName": "Wrong competition player",
  "teamCode": "BEN",
  "teamName": "SL Benfica"
}

