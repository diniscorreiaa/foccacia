@api = http://localhost:1904
@accept-content = application/json

@season = 2025
@compPPL = PPL
@compCL = CL

# IDs usados nos exemplos
@groupId = 1
@otherGroupId = 2
@playerId = 1903

# Tokens:
# 1) Cria primeiro 1 utilizador e copia o token devolvido para @token
# 2) Cria um 2º utilizador e copia o token para @otherToken (para testar 403)
@token = Bearer 4ae2ebd0-f89d-4a35-8806-4c0608a7e401
@otherToken = Bearer aa13857f-6fb5-4800-bb9a-33312fa9ceb0
@invalidToken = Bearer invalid-token

### GET - Todas as Competições Disponíveis (200)
GET {{api}}/competitions
Accept: {{accept-content}}

### GET - Equipas da Primeira Liga da Época {{season}} (200)
GET {{api}}/competitions/{{compPPL}}/seasons/{{season}}/teams
Accept: {{accept-content}}

### GET - Equipas da Champions League da Época {{season}} (200)
GET {{api}}/competitions/{{compCL}}/seasons/{{season}}/teams
Accept: {{accept-content}}

### POST - Cria um novo Utilizador (201) -> usar resposta para @token
POST {{api}}/users
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "username": "grupo1"
}

### NEGATIVO - 400 (Falta username)
POST {{api}}/users
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
}

### POST - Cria 2º Utilizador (201) -> usar resposta para @otherToken
POST {{api}}/users
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "username": "grupo2"
}

### GET - Grupos do Utilizador (200)
GET {{api}}/groups
Authorization: {{token}}
Accept: {{accept-content}}

### NEGATIVO - 401 (Sem token)
GET {{api}}/groups
Accept: {{accept-content}}

### NEGATIVO - 401 (Token inválido)
GET {{api}}/groups
Authorization: {{invalidToken}}
Accept: {{accept-content}}

### POST - Cria um Novo Grupo (201)
POST {{api}}/groups
Authorization: {{token}}
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "name": "Melhores da Champions",
  "description": "Onze ideal da Champions {{season}}",
  "competition": "{{compCL}}",
  "year": {{season}}
}

### NEGATIVO - 400 (Dados em falta na criação do grupo)
POST {{api}}/groups
Authorization: {{token}}
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "name": "Sem competition e year"
}

### GET - Grupo {{groupId}} do Utilizador (200)
GET {{api}}/groups/{{groupId}}
Authorization: {{token}}
Accept: {{accept-content}}

### NEGATIVO - 404 (Grupo não encontrado)
GET {{api}}/groups/99999
Authorization: {{token}}
Accept: {{accept-content}}

### NEGATIVO - 400 (groupId não numérico)
GET {{api}}/groups/abc
Authorization: {{token}}
Accept: {{accept-content}}

### PUT - Edita Nome e Descrição de um Grupo (200)
PUT {{api}}/groups/{{groupId}}
Authorization: {{token}}
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "name": "Melhores da Champions (Atualizado)",
  "description": "Onze ideal da Champions {{season}} (atualizado)"
}

### NEGATIVO - 400 (Body inválido no PUT - falta campos válidos)
PUT {{api}}/groups/{{groupId}}
Authorization: {{token}}
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "name": ""
}

### POST - Adiciona Jogador 1 ao Grupo (200 - válido competition/year)
POST {{api}}/groups/{{groupId}}/players
Authorization: {{token}}
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "playerId": {{playerId}},
  "playerName": "Jogador 1",
  "teamId": 1001,
  "teamName": "Equipa 1",
  "position": "Midfielder",
  "nationality": "Portugal",
  "age": 20,
  "competition": "{{compCL}}",
  "year": {{season}}
}

### NEGATIVO - 400 (Body inválido ao adicionar jogador - faltam IDs obrigatórios)
POST {{api}}/groups/{{groupId}}/players
Authorization: {{token}}
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "playerName": "Sem IDs obrigatórios",
  "competition": "{{compCL}}",
  "year": {{season}}
}

### NEGATIVO - 422 (Jogador não pertence à competição/ano do grupo)
POST {{api}}/groups/{{groupId}}/players
Authorization: {{token}}
Content-Type: {{accept-content}}
Accept: {{accept-content}}

{
  "playerId": 2000,
  "playerName": "Jogador Comp Errada",
  "teamId": 1002,
  "teamName": "Equipa 2",
  "position": "Defender",
  "nationality": "Portugal",
  "age": 21,
  "competition": "{{compPPL}}",
  "year": {{season}}
}

