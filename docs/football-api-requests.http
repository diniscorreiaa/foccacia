@api = http://api.football-data.org/v4
@token = a665d4ef3ef94e87bcafc8bdf1a4f9de
@accept = application/json
@season = 2025
@compPPL = PPL
@compCL = CL
@benficaId = 1903

### GET - Todas as Competições
GET {api}/competitions
X-Auth-Token: {token}
Accept: {accept}

>> ./output/football-api-responses/fapi-competitions.json

### GET - Competição: Primeira Liga Portuguesa
GET {api}/competitions/{compPPL}
X-Auth-Token: {token}
Accept: {accept}

>> ./output/football-api-responses/fapi-competitions-{{compPPL}}.json

### GET - Equipas da Primeira Liga Portuguesa da Época 2025 ({{season}})
GET {api}/competitions/{compPPL}/teams?season={season}
X-Auth-Token: {token}
Accept: {accept}

>> ./output/football-api-responses/fapi-{{compPPL}}-teams-{{season}}.json

### GET - Competição: UEFA Champions League
GET {api}/competitions/{compCL}
X-Auth-Token: {token}
Accept: {accept}

>> ./output/football-api-responses/fapi-competitions-{{compCL}}.json

### GET - Equipas da Champions League da Época 2025 ({{season}})
GET {api}/competitions/{compCL}/teams?season={season}
X-Auth-Token: {token}
Accept: {accept}

>> ./output/football-api-responses/fapi-{{compCL}}-teams-{{season}}.json

### GET - Detalhes da equipa SL Benfica
GET {api}/teams/{benficaId}
X-Auth-Token: {token}
Accept: {accept}

>> ./output/football-api-responses/fapi-team-{{benficaId}}.json

