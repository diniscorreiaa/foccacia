@api = http://api.football-data.org/v4
@token = a665d4ef3ef94e87bcafc8bdf1a4f9de

# ==========================================
#  Testes à Football Data API – FOCCACIA
#  Época: 2025
# ==========================================


### GET - Competição: Primeira Liga Portuguesa
GET {{api}}/competitions/PPL
X-Auth-Token: {{token}}
Accept: application/json


### GET - Equipas da Primeira Liga Portuguesa (2025)
GET {{api}}/competitions/PPL/teams?season=2025
X-Auth-Token: {{token}}
Accept: application/json


### GET - Competição: UEFA Champions League
GET {{api}}/competitions/CL
X-Auth-Token: {{token}}
Accept: application/json


### GET - Equipas da Champions League (2025)
GET {{api}}/competitions/CL/teams?season=2025
X-Auth-Token: {{token}}
Accept: application/json


### GET - Detalhes da equipa SL Benfica
# Benfica normalmente tem o ID 1903 na Football Data API
GET {{api}}/teams/1903
X-Auth-Token: {{token}}
Accept: application/json
