  "version": "1.0.0",
  "private": true,
  "description": "FOCCACIA (Football Complete Clubs Api and Chelas Internet Application).",
  "type": "module",
  "workspaces": ["foccacia-server","foccacia-web-api","foccacia-services","fapi-teams-data","foccacia-data-mem"],
  "main": "foccacia-server/src/foccacia-server.mjs",
  "scripts": {
    "start": "node foccacia-server/src/foccacia-server.mjs",

    "test:web-api": "npm --workspace=foccacia-web-api run test",
    "test:foccacia-server": "npm --workspace=foccacia-server run test",
    "test:foccacia-services": "npm --workspace=foccacia-services run test",
    "test:fapi-teams-data": "npm --workspace=fapi-teams-data run test",
    "test:foccacia-data-mem": "npm --workspace=foccacia-data-mem run test",
    "test:others": "npm run test:foccacia-server && npm run test:foccacia-services && npm run test:fapi-teams-data && npm run test:foccacia-data-mem",
    "test": "npm run test:web-api && npm run test:others",

    "coverage:web-api": "npm --workspace=foccacia-web-api run coverage",
    "coverage:foccacia-server": "npm --workspace=foccacia-server run coverage || true",
    "coverage:foccacia-services": "npm --workspace=foccacia-services run coverage || true",
    "coverage:fapi-teams-data": "npm --workspace=fapi-teams-data run coverage || true",
    "coverage:foccacia-data-mem": "npm --workspace=foccacia-data-mem run coverage || true",
    "coverage:all": "npm run coverage:web-api && npm run coverage:foccacia-server && npm run coverage:foccacia-services && npm run coverage:fapi-teams-data && npm run coverage:foccacia-data-mem",

    "format:mjs": "prettier --write \"**/*.mjs\""
  },
