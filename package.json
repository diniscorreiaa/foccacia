{
  "name": "isel-leic-ipw-pi-2526i-foccacia-leic2526i-ipw31d-g01",
  "version": "1.0.0",
  "private": true,
  "description": "FOCCACIA (Football Complete Clubs Api and Chelas Internet Application).",
  "type": "module",
  "workspaces": [
    "foccacia-server",
    "foccacia-web-api",
    "foccacia-services",
    "fapi-teams-data",
