    "test:foccacia-data-mem": "npm --workspace=foccacia-data-mem run test",
    "test:foccacia-utils": "npm --workspace=foccacia-utils run test",
    "test:all": "npm run test:web-api && npm run test:foccacia-server && npm run test:foccacia-services && npm run test:fapi-teams-data && npm run test:foccacia-data-mem && npm run test:foccacia-utils",
    "coverage:web-api": "npm --workspace=foccacia-web-api run coverage",
    "coverage:foccacia-server": "npm --workspace=foccacia-server run coverage",
    "coverage:foccacia-services": "npm --workspace=foccacia-services run coverage",
    "coverage:fapi-teams-data": "npm --workspace=fapi-teams-data run coverage",
    "coverage:foccacia-data-mem": "npm --workspace=foccacia-data-mem run coverage",
    "coverage:foccacia-utils": "npm --workspace=foccacia-utils run coverage",
    "coverage:all": "npm run coverage:web-api && npm run coverage:foccacia-server && npm run coverage:foccacia-services && npm run coverage:fapi-teams-data && npm run coverage:foccacia-data-mem && npm run coverage:foccacia-utils",
    "format:mjs": "prettier --write \"**/*.mjs\"",
    "format:yaml": "prettier --write \"**/*.{yaml,yml}\"",
    "format:json": "prettier --write \"**/*.json\"",
    "format:all": "npm run format:mjs && npm run format:yaml && npm run format:json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isel-leic-ipw/isel-leic-ipw-pi-2526i-foccacia-leic2526i-ipw31d-g01"
