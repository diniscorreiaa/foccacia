<section class="p-4 bg-light border rounded">
    <h1 class="h4 mb-3">Competitions</h1>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Name</th>
                <th style="width: 360px;">Season</th>
                <th class="text-end"></th>
            </tr>
            </thead>

            <tbody>
            {{#each competitions}}
                <tr>
                    <td>{{name}}</td>

                    <td>
                        <form class="js-teams-form d-flex gap-2" data-code="{{code}}">
                            <select class="form-select" name="season" required>
                                {{#each seasons}}
                                    <option value="{{this}}">{{this}}</option>
                                {{/each}}
                            </select>

                            <button type="submit" class="btn btn-primary btn-sm">View Teams</button>
                        </form>
                    </td>

                    <td class="text-end text-muted small">
                        Code: <strong>{{code}}</strong>
                    </td>
                </tr>
            {{/each}}
            </tbody>
        </table>
    </div>
</section>

<script>
    document.addEventListener("submit", (e) => {
        const form = e.target;
        if (!form.classList || !form.classList.contains("js-teams-form")) return;

        e.preventDefault();

        const code = form.dataset.code;
        const season = form.querySelector('select[name="season"]').value;

        if (!code || !season) return;

        window.location.href = `/competitions/${code}/seasons/${encodeURIComponent(season)}/teams`;
    });
</script>
