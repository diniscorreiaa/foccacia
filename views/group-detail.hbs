<fieldset style="border: 5px solid #ccc; max-width: fit-content; margin: 50px">
        {{#with group}}
        <h1>{{name}}</h1>
        <h5>{{description}}</h5>
        <h6>Competition: {{competition}}</h6>
        <h6>Season: {{year}}</h6>
        <h6>Players:</h6>
        {{#each players}}
        <h6>{{playerName}}</h6>
        <ul>
                <li>
                        <b>Team:</b> {{teamName}}
                </li>
                <li>
                        <b>Position:</b> {{position}}
                </li>
                <li>
                        <b>Country:</b> {{nationality}}
                </li>
                <li>
                        <b>Age:</b> {{age}}
                </li>
        </ul>
        {{/each}}
        {{/with}}
</fieldset>