<h1 class="h3 mb-4">Groups</h1>

<section class="p-4 bg-light border rounded mb-4">
    <h2 class="h5 mb-3">Create group</h2>

    <form method="post" action="/groups" class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Name</label>
            <input class="form-control" type="text" name="name" minlength="3" required>
        </div>

        <div class="col-md-6">
            <label class="form-label">Competition</label>
            <select id="competitionSelect" class="form-select" name="competitions" required>
                {{#each competitions}}
                    <option value="{{code}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                {{/each}}
            </select>
            <div class="form-text">
                Changing the competition reloads the page to load valid seasons.
            </div>
        </div>

        <div class="col-12">
            <label class="form-label">Description</label>
            <textarea class="form-control" name="description" rows="3" minlength="3" required></textarea>
        </div>

        <div class="col-md-4">
            <label class="form-label">Season</label>

            {{#if seasons.length}}
                <select class="form-select" name="seasons" required>
                    {{#each seasons}}
                        <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
            {{else}}
                <div class="alert alert-warning mb-0">
                    No valid seasons available for this competition.
                </div>
            {{/if}}
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary" {{#unless seasons.length}}disabled{{/unless}}>
                Create
            </button>
        </div>
    </form>
</section>

<h2 class="h5 mb-3">Your groups</h2>

{{#each groups}}
    <section class="p-4 bg-light border rounded mb-3">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <h3 class="h5 mb-1">{{name}}</h3>
                <p class="text-muted mb-2">{{description}}</p>

                <div class="small text-muted">
                    Competition: <strong>{{competition}}</strong>
                    · Season: <strong>{{year}}</strong>
                    · Players:
                    <strong>{{#if players}}{{players.length}}{{else}}0{{/if}}</strong>
                </div>
            </div>

            <a class="btn btn-outline-secondary btn-sm" href="/groups/{{id}}">Details</a>
        </div>

        <hr class="my-3">

        <form method="post" action="/groups/{{id}}/update" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Name</label>
                <input class="form-control" type="text" name="name" value="{{name}}" minlength="3" required>
            </div>

            <div class="col-md-6">
                <label class="form-label">Description</label>
                <input class="form-control" type="text" name="description" value="{{description}}" minlength="3" required>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-warning btn-sm">Update</button>
            </div>
        </form>

        <hr class="my-3">

        <form method="post" action="/groups/{{id}}" class="js-delete-group" data-group-id="{{id}}">
        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
        </form>
    </section>
{{else}}
    <div class="alert alert-info">
        No groups yet. Create your first group above.
    </div>
{{/each}}

<script>
    const select = document.getElementById("competitionSelect");
    if (select) {
        select.addEventListener("change", () => {
            const code = select.value;
            window.location.href = `/groups?competition=${encodeURIComponent(code)}`;
        });
    }

    document.querySelectorAll("form.js-delete-group").forEach((form) => {
        form.addEventListener("submit", async (evento) => {
            evento.preventDefault();

            const groupId = form.dataset.groupId;
            if (!groupId) return;

            const ok = confirm("Delete this group?");
            if (!ok) return;

            try {
                const res = await fetch(`/api/groups/${encodeURIComponent(groupId)}`, {
                    method: "DELETE",
                });

                if (res.status === 204) {
                    window.location.reload();
                    return;
                }

                if (res.status === 401) {
                    window.location.href = "/login";
                    return;
                }

                const body = await res.text();
                alert(`Delete failed (${res.status}).`);
                console.error(body);
            } catch (err) {
                // fallback: mantém comportamento antigo
                form.submit();
            }
        });
    });
</script>
