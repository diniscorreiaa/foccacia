<h1>Groups</h1>
{{!--TODO: Move styles to a seperate .css file, inline css is not recommended --}}
<fieldset style="border: 5px solid #020202; max-width: fit-content; margin: 50px">
        <legend>Create Group</legend>
        <form method="post">
                <label>Name</label>
                <input type="text" name="name"><br>
                <label>Description</label><br>
                <textarea name="description" rows="4" cols="50"></textarea><br>
                <label>Competition</label>
                <select name="competitions">
                        {{#each competitions}}
                                <option value="{{code}}">{{name}}</option>
                        {{/each}}
                </select><br>
                <label>Season</label>
                <select name="seasons">
                        {{#each seasons}}
                                <option>{{this}}</option>
                        {{/each}}
                </select><br>
                <input type="submit" value ="Create group">
        </form>
</fieldset>
{{#each groups}}
<fieldset style="border: 5px solid #ccc; max-width: fit-content; margin: 50px">
        <legend class="name" contenteditable="true" data-actual-name="{{name}}">{{name}}</legend>
        <p class="description" contenteditable="true" data-actual-description="{{description}}">{{description}}</p>

        <form action="groups/{{id}}">
                <input type="submit" value ="Check group details">
        </form>

        {{!--TODO: Maybe the content editable can be put directly in the form --}}
        {{!--TODO: the update logic and structure is way too complex for such a simple problem, refactor if we have time--}}
        <button type="button" class="cancelUpdate" style="background-color: yellow" disabled>Cancel</button>
        <form action="/groups/{{id}}/update" method="post">
            <input class="updateNameForm" type="hidden" name="name" value="">
            <input class="updateDescriptionForm" type="hidden" name="description" value="">
            <input class="update" type="submit" value="Update Group" style="background-color:yellow">
        </form>

        <form action="/groups/{{id}}" method="post">
            <input type="submit" value="Delete group" style="background-color: red;">
        </form>
</fieldset>
{{/each}}
<script> {{!--TODO: Do not rely on idx --}}
    [...document.getElementsByClassName("cancelUpdate")].forEach(
            (node, idx) =>
                node.onclick = () => {
                    const currentName = document.getElementsByClassName("name")[idx]
                    const currentDescription = document.getElementsByClassName("description")[idx]

                    currentName.textContent = currentName.dataset.actualName
                    currentDescription.textContent = currentDescription.dataset.actualDescription

                    node.disabled = true
                }
    );

    [...document.getElementsByClassName("name")].forEach(
            (node, idx) =>
                    node.oninput = () => {document.getElementsByClassName("cancelUpdate")[idx].disabled = false}
    );

    [...document.getElementsByClassName("description")].forEach(
            (node, idx) =>
                    node.oninput = () => {document.getElementsByClassName("cancelUpdate")[idx].disabled = false}
    );

    [...document.getElementsByClassName("update")].forEach(
            (node, idx) => {
                node.onclick = () => {
                    document.getElementsByClassName("cancelUpdate")[idx].disabled = true

                    const currentName = document.getElementsByClassName("name")[idx]
                    const currentDescription = document.getElementsByClassName("description")[idx]

                    currentName.dataset.actualName = currentName.textContent
                    currentDescription.dataset.actualDescription = currentDescription.textContent

                    document.getElementsByClassName("updateNameForm")[idx].value = currentName.textContent
                    document.getElementsByClassName("updateDescriptionForm")[idx].value = currentDescription.textContent
                }
            }
    )
</script>